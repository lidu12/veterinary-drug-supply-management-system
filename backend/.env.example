PORT=5000
NODE_ENV=development
JWT_SECRET=tropical_vet_super_secret_jwt_key_2026_production_security
JWT_EXPIRES_IN=8h

# Allowed frontend origin (e.g., https://your-portfolio-app.vercel.app)
FRONTEND_URL=http://localhost:3000

# Cloud Database Connection String (e.g. from Neon, Supabase, Render)
# If DATABASE_URL is set, it will be used instead of individual DB_* variables below
DATABASE_URL=postgresql://user:password@ep-sample.neon.tech/neondb?sslmode=require

# Local PostgreSQL Credentials (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tropical_vet_db
DB_USER=postgres
DB_PASSWORD=postgres
